#!/usr/bin/env -S deno run --allow-all
// Bundles zenoh-web's browser client with zenoh-dimos-codecs' decoders (registered), at the revs
// Cargo.toml pins, into web/vendor/zenoh_web.js. web_ctrl compiles that file in and serves it, so the
// page works on a robot with no internet. Run it whenever either rev changes.

import { $ } from "https://esm.sh/dax-sh@0.42.0"

const repoRoot = $.path(import.meta.url).parentOrThrow().parentOrThrow()
const cargoToml = repoRoot.join("Cargo.toml").readTextSync()
/** @param {string} name */
const revOf = (name) => {
    const rev = cargoToml.match(new RegExp(`${name} = \\{[^}]*rev = "([0-9a-f]+)"`))?.[1]
    if (!rev) {
        throw new Error(`no ${name} rev pinned in Cargo.toml`)
    }
    return rev
}
const revs = { "zenoh-web": revOf("zenoh-web"), "zenoh-dimos-codecs": revOf("zenoh-dimos-codecs") }

const work = $.path(await Deno.makeTempDir({ prefix: "zenoh_web_client_" }))
try {
    for (const [name, rev] of Object.entries(revs)) {
        await $`git clone --quiet --filter=blob:none https://github.com/jeff-hykin/${name} ${work.join(name)}`
        await $`git -C ${work.join(name)} checkout --quiet ${rev}`
    }
    const entry = work.join("entry.ts")
    entry.writeTextSync([
        `import { registerCodec } from "./zenoh-web/client/zenoh_web.ts"`,
        `import { registerDimosCodecs } from "./zenoh-dimos-codecs/client/dimos_codecs.ts"`,
        `export * from "./zenoh-web/client/zenoh_web.ts"`,
        `export * from "./zenoh-dimos-codecs/client/dimos_codecs.ts"`,
        "registerDimosCodecs(registerCodec)",
    ].join("\n"))
    const bundled = work.join("zenoh_web.js")
    // Deno.Command rather than dax: inside dax `deno bundle` resolved to `deno run bundle`
    const { code } = await new Deno.Command(Deno.execPath(), {
        args: ["bundle", "--quiet", "--platform", "browser", "-o", bundled.toString(), entry.toString()],
        stdout: "inherit",
        stderr: "inherit",
    }).output()
    if (code !== 0) {
        throw new Error(`deno bundle failed with exit code ${code}`)
    }
    const header = `// zenoh-web browser client with zenoh-dimos-codecs' decoders, bundled from github.com/jeff-hykin/zenoh-web@${revs["zenoh-web"]} and github.com/jeff-hykin/zenoh-dimos-codecs@${revs["zenoh-dimos-codecs"]} by run/vendor_zenoh_web. Do not edit.\n`
    const target = repoRoot.join("web/vendor/zenoh_web.js")
    // esbuild names each source by its path, which here is a random temp directory
    const body = bundled.readTextSync().replace(/^\/\/ .*zenoh_web_client_[^/]+\//gm, "// ")
    target.writeTextSync(header + body)
    console.log(`wrote ${target} (zenoh-web ${revs["zenoh-web"].slice(0, 7)}, zenoh-dimos-codecs ${revs["zenoh-dimos-codecs"].slice(0, 7)})`)
} finally {
    await Deno.remove(work.toString(), { recursive: true })
}
